#!/bin/sh
# Rejects commit messages that are not Conventional Commits: type(scope)!: summary
subject=$(head -n 1 "$1")
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi
echo "Commit rechazado: el mensaje tiene que seguir Conventional Commits." >&2
echo "  Ejemplos: 'fix: no perder el foco al cambiar de escritorio'  'feat(trackpad): gesto de 3 dedos'" >&2
echo "  Tipos: feat, fix, perf, refactor, docs, style, test, build, ci, chore, revert. Ver CONTRIBUTING.md." >&2
exit 1
